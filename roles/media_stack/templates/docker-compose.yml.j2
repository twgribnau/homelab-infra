---
# {{ ansible_managed }}
name: media-stack

networks:
  default:
    name: {{ homelab_docker_network }}
    external: true

x-linuxserver-env: &linuxserver-env
  PUID: "{{ homelab_uid }}"
  PGID: "{{ homelab_gid }}"
  TZ: {{ homelab_tz }}
  UMASK: "002"

services:
  jellyfin:
    image: {{ media_stack_images.jellyfin }}
    environment: *linuxserver-env
{% if not homelab_ci | bool %}
    # Intel iGPU for hardware transcoding; the image adds itself to the device's group.
    devices: [/dev/dri:/dev/dri]
{% endif %}
    volumes:
      - {{ homelab_stack_dirs.media }}/appdata/jellyfin:/config
      - {{ homelab_data_dir }}/media:/data/media:ro
    ports:
      - "{{ homelab_jellyfin_publish_ip }}:{{ homelab_ports.jellyfin }}:8096"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://localhost:8096/health"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 60s
    restart: unless-stopped

  seerr:
    image: {{ media_stack_images.seerr }}
    init: true
    environment:
      LOG_LEVEL: info
      TZ: {{ homelab_tz }}
    volumes:
      - {{ homelab_stack_dirs.media }}/appdata/seerr:/app/config
    ports:
      - "{{ homelab_publish_ip }}:{{ homelab_ports.seerr }}:5055"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:5055/api/v1/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 30s
    restart: unless-stopped

  radarr:
    image: {{ media_stack_images.radarr }}
    environment: *linuxserver-env
    volumes:
      - {{ homelab_stack_dirs.media }}/appdata/radarr:/config
      - {{ homelab_data_dir }}:/data
    ports:
      - "{{ homelab_publish_ip }}:{{ homelab_ports.radarr }}:7878"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://localhost:7878/ping"]
      interval: 60s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  sonarr:
    image: {{ media_stack_images.sonarr }}
    environment: *linuxserver-env
    volumes:
      - {{ homelab_stack_dirs.media }}/appdata/sonarr:/config
      - {{ homelab_data_dir }}:/data
    ports:
      - "{{ homelab_publish_ip }}:{{ homelab_ports.sonarr }}:8989"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://localhost:8989/ping"]
      interval: 60s
      timeout: 10s
      retries: 3
    restart: unless-stopped

{% if homelab_bazarr | bool %}
  # Subtitles for what Radarr and Sonarr import.
  bazarr:
    image: {{ media_stack_images.bazarr }}
    environment: *linuxserver-env
    volumes:
      - {{ homelab_stack_dirs.media }}/appdata/bazarr:/config
      - {{ homelab_data_dir }}/media:/data/media
    ports:
      - "{{ homelab_publish_ip }}:{{ homelab_ports.bazarr }}:6767"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://localhost:6767/api/system/ping"]
      interval: 60s
      timeout: 10s
      retries: 3
    restart: unless-stopped

{% endif %}
  # Syncs TRaSH Guides profiles, custom formats and naming into Radarr and Sonarr.
  # Its config is written by the app_config role, which knows the API keys.
  recyclarr:
    image: {{ media_stack_images.recyclarr }}
    user: "{{ homelab_uid }}:{{ homelab_gid }}"
    environment:
      TZ: {{ homelab_tz }}
      CRON_SCHEDULE: "{{ media_stack_recyclarr_schedule }}"
    volumes:
      - {{ homelab_stack_dirs.media }}/appdata/recyclarr:/config
    depends_on: [radarr, sonarr]
    restart: unless-stopped
