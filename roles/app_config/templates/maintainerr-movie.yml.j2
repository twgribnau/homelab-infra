# Maintainerr's rule format (Rules > Export shows the same). Sections are evaluated in order:
# (requester watched it OR (nobody requested it AND someone watched it))
# AND last watched long enough ago AND nobody made it a favourite.
mediaType: MOVIES
rules:
  - "0":
      - firstValue: Seerr.addUser
        action: CONTAINS
        lastValue: Jellyfin.seenBy
  - "1":
      - operator: OR
        firstValue: Seerr.isRequested
        action: EQUALS
        customValue:
          type: boolean
          value: "false"
      - operator: AND
        firstValue: Jellyfin.seenBy
        action: COUNT_BIGGER
        customValue:
          type: number
          value: 0
  - "2":
      - operator: AND
        firstValue: Jellyfin.lastViewedAt
        action: BEFORE
        customValue:
          type: custom_days
          value: "{{ app_config_maintainerr_days.movie }}"
  - "3":
      - operator: AND
        firstValue: Jellyfin.favoritedBy
        action: COUNT_SMALLER
        customValue:
          type: number
          value: 1
