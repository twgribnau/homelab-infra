# Maintainerr's rule format (Rules > Export shows the same). Sections are evaluated in order, per
# season: (requester watched every episode OR (nobody requested the show AND someone watched every
# episode)) AND the newest episode was watched long enough ago AND nobody made the season or show
# a favourite AND the season is complete (its finale is there).
mediaType: SEASONS
rules:
  - "0":
      - firstValue: Seerr.addUser
        action: CONTAINS
        lastValue: Jellyfin.sw_allEpisodesSeenBy
  - "1":
      - operator: OR
        firstValue: Seerr.isRequested
        action: EQUALS
        customValue:
          type: boolean
          value: "false"
      - operator: AND
        firstValue: Jellyfin.sw_allEpisodesSeenBy
        action: COUNT_BIGGER
        customValue:
          type: number
          value: 0
  - "2":
      - operator: AND
        firstValue: Jellyfin.sw_lastWatched
        action: BEFORE
        customValue:
          type: custom_days
          value: "{{ app_config_maintainerr_days.season }}"
  - "3":
      - operator: AND
        firstValue: Jellyfin.sw_favoritedBy_including_parent
        action: COUNT_SMALLER
        customValue:
          type: number
          value: 1
  - "4":
      - operator: AND
        firstValue: Sonarr.seasonFinale
        action: EQUALS
        customValue:
          type: boolean
          value: "true"
      - operator: OR
        firstValue: Sonarr.seriesFinale
        action: EQUALS
        customValue:
          type: boolean
          value: "true"
