---
# {{ ansible_managed }}
name: monitoring-stack

networks:
  default:
    name: {{ homelab_docker_network }}
    external: true

services:
{% if homelab_monitoring | bool %}
  prometheus:
    image: {{ monitoring_stack_images.prometheus }}
    user: "{{ monitoring_stack_prometheus_uid }}:{{ monitoring_stack_prometheus_uid }}"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ monitoring_stack_prometheus_retention }}
    volumes:
      - {{ homelab_stack_dirs.monitoring }}/appdata/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ homelab_stack_dirs.monitoring }}/appdata/prometheus/data:/prometheus
    ports:
      - "{{ homelab_publish_ip }}:{{ homelab_ports.prometheus }}:9090"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://localhost:9090/-/healthy"]
      interval: 60s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  grafana:
    image: {{ monitoring_stack_images.grafana }}
    user: "{{ monitoring_stack_grafana_uid }}:{{ monitoring_stack_grafana_uid }}"
    env_file: [grafana.env]
    environment:
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /etc/grafana/provisioning/dashboards/homelab-overview.json
      TZ: {{ homelab_tz }}
    volumes:
      - {{ homelab_stack_dirs.monitoring }}/appdata/grafana/data:/var/lib/grafana
      - {{ homelab_stack_dirs.monitoring }}/appdata/grafana/provisioning:/etc/grafana/provisioning:ro
    ports:
      - "{{ homelab_publish_ip }}:{{ homelab_ports.grafana }}:3000"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://localhost:3000/api/health"]
      interval: 60s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # No host ports: Prometheus scrapes node-exporter:9100 and cadvisor:8080.
  node-exporter:
    image: {{ monitoring_stack_images.node_exporter }}
    command: [--path.rootfs=/host]
    pid: host
    volumes:
      - /:/host:ro,rslave
    restart: unless-stopped

  cadvisor:
    image: {{ monitoring_stack_images.cadvisor }}
    privileged: true
    devices: [/dev/kmsg]
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    restart: unless-stopped
{% endif %}
{% if homelab_homepage | bool %}

  # Start page with every app and live widgets. app_config writes its services.yaml (API keys).
  homepage:
    image: {{ monitoring_stack_images.homepage }}
    environment:
      PUID: "{{ homelab_uid }}"
      PGID: "{{ homelab_gid }}"
      HOMEPAGE_ALLOWED_HOSTS: "{{ homelab_host }},{{ homelab_host }}:{{ homelab_ports.homepage }}"
    volumes:
      - {{ homelab_stack_dirs.monitoring }}/appdata/homepage:/app/config
    ports:
      - "{{ homelab_publish_ip }}:{{ homelab_ports.homepage }}:3000"
    restart: unless-stopped
{% endif %}
