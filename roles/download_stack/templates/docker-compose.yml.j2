---
# {{ ansible_managed }}
name: download-stack

networks:
  default:
    name: {{ homelab_docker_network }}
    external: true

services:
{% if homelab_vpn | bool %}
  gluetun:
    image: {{ download_stack_images.gluetun }}
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      VPN_SERVICE_PROVIDER: custom
      VPN_TYPE: wireguard
      TZ: {{ homelab_tz }}
{% if homelab_torrent_port_forwarded | bool %}
      FIREWALL_VPN_INPUT_PORTS: "{{ homelab_torrent_port }}"
{% endif %}
    volumes:
      - {{ homelab_stack_dirs.download }}/wireguard/wg0.conf:/gluetun/wireguard/wg0.conf:ro
    ports:
      # qBittorrent's WebUI, published here because qBittorrent shares gluetun's network.
      - "{{ homelab_publish_ip }}:{{ homelab_ports.qbittorrent }}:{{ homelab_ports.qbittorrent }}"
    restart: unless-stopped

{% endif %}
  qbittorrent:
    image: {{ download_stack_images.qbittorrent }}
{% if not homelab_vpn | bool %}
    # No VPN. The alias keeps the address the other apps use.
    networks:
      default:
        aliases:
          - gluetun
    ports:
      - "{{ homelab_publish_ip }}:{{ homelab_ports.qbittorrent }}:{{ homelab_ports.qbittorrent }}"
{% else %}
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_healthy
{% endif %}
    environment:
      PUID: "{{ homelab_uid }}"
      PGID: "{{ homelab_gid }}"
      TZ: {{ homelab_tz }}
      UMASK: "002"
      WEBUI_PORT: "{{ homelab_ports.qbittorrent }}"
      TORRENTING_PORT: "{{ homelab_torrent_port }}"
    volumes:
      - {{ homelab_stack_dirs.download }}/appdata/qbittorrent:/config
      - {{ homelab_data_dir }}:/data
    healthcheck:
      # Fails when the VPN is down or gluetun restarted underneath it; autoheal then
      # restarts qBittorrent so it re-attaches to gluetun's network.
      test:
        - "CMD"
        - "curl"
        - "-fsS"
        - "--max-time"
        - "15"
        - "-o"
        - "/dev/null"
        - "https://www.cloudflare.com/cdn-cgi/trace"
      interval: 60s
      timeout: 20s
      retries: 3
      start_period: 60s
    labels:
      autoheal: "true"
    stop_grace_period: 30s
    restart: unless-stopped

  prowlarr:
    image: {{ download_stack_images.prowlarr }}
    environment:
      PUID: "{{ homelab_uid }}"
      PGID: "{{ homelab_gid }}"
      TZ: {{ homelab_tz }}
      UMASK: "002"
    volumes:
      - {{ homelab_stack_dirs.download }}/appdata/prowlarr:/config
    ports:
      - "{{ homelab_publish_ip }}:{{ homelab_ports.prowlarr }}:9696"
    healthcheck:
      test:
        - "CMD"
        - "curl"
        - "-fsS"
        - "-o"
        - "/dev/null"
        - "http://localhost:9696/ping"
      interval: 60s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # No host port: it has no login. Prowlarr reaches it at http://flaresolverr:8191.
  flaresolverr:
    image: {{ download_stack_images.flaresolverr }}
    environment:
      LOG_LEVEL: info
      TZ: {{ homelab_tz }}
    restart: unless-stopped

  autoheal:
    image: {{ download_stack_images.autoheal }}
    network_mode: none
    environment:
      AUTOHEAL_START_PERIOD: "300"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    restart: unless-stopped
