# {{ ansible_managed }}
[Unit]
Description=Back up the homelab to {{ homelab_backup_remote }}
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/homelab-backup/env
# restic's cache, so it doesn't read its index from the cloud each night.
CacheDirectory=homelab-backup
Environment=RESTIC_CACHE_DIR=/var/cache/homelab-backup
ExecStart=/usr/local/bin/homelab-backup
