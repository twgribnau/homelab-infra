# {{ ansible_managed }}
[Unit]
Description=Telegram bot for homelab deploys and status
Wants=network-online.target
After=network-online.target

[Service]
User={{ homelab_user }}
EnvironmentFile=/etc/homelab-bot.env
Environment=HOMELAB_REPO_DIR={{ autodeploy_dir }}
Environment=HOMELAB_STATE_DIR={{ homelab_state_dir }}
Environment=HOMELAB_DATA_DIR={{ homelab_data_dir }}
Environment=HOMELAB_REPO_URL={{ autodeploy_web_url }}
ExecStart=/usr/local/bin/homelab-bot
Restart=always
RestartSec=30
# /deploy starts the deploy service through polkit (homelab-bot.rules), so no sudo is needed.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# Only the hold on automatic deploys (/hold, /main) is written.
ReadWritePaths={{ homelab_state_dir }}
PrivateTmp=true

[Install]
WantedBy=multi-user.target
