#!/bin/bash
# {{ ansible_managed }}
# Runs the playbook when main on GitHub has new commits, or your config repo (config/) has.
# Before new images it backs up the app data; when the run fails it restores that backup and
# deploys the previous commit again. A failing config change is left for you to fix.
# Started by homelab-autodeploy.timer; the full output is in: journalctl -u homelab-autodeploy
set -uo pipefail
cd {{ autodeploy_dir }} || exit 1
export GIT_SSH_COMMAND="ssh -i {{ autodeploy_key }} -o IdentitiesOnly=yes"
stacks=()
for dir in {{ homelab_stack_dirs.values() | join(' ') }}; do [ -d "$dir" ] && stacks+=("$dir"); done  # optional ones may be off
# What the backup holds: the app data, and the ebook library, which holds Calibre-Web's database.
backup_dirs=("${stacks[@]}")
[ -d {{ homelab_data_dir }}/media/books ] && backup_dirs+=({{ homelab_data_dir }}/media/books)
web={{ autodeploy_web_url }}

# Messages are Telegram HTML: text that isn't markup goes through html first.
notify() {
  [ -n "${TELEGRAM_BOT_TOKEN:-}" ] || return 0
  curl -s -o /dev/null --max-time 20 "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" --data-urlencode "text=$1" \
    --data-urlencode "parse_mode=HTML" --data-urlencode 'link_preview_options={"is_disabled":true}'
}
html() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' <<<"$1"; }
# The release a commit belongs to: v1.1.0, or v1.1.0 + 3 commits since that tag.
version() { git describe --tags --always "$1" | sed -E 's/-([0-9]+)-g[0-9a-f]+$/ + \1 commits/'; }
restic() { sudo --preserve-env=RESTIC_REPOSITORY,RESTIC_PASSWORD restic "$@"; }
compose() { for dir in "${stacks[@]}"; do docker compose --project-directory "$dir" "$1"; done; }
deploy() {
  .venv/bin/pip install -q -r requirements.txt >"$log" 2>&1 &&
    .venv/bin/ansible-galaxy collection install -r collections/requirements.yml >>"$log" 2>&1 &&
    .venv/bin/ansible-playbook provision.yml >>"$log" 2>&1
  local status=$?
  cat "$log"
  return "$status"
}

git fetch --quiet --tags origin main || exit 1
new=$(git rev-parse FETCH_HEAD)
old=$(git rev-parse HEAD)
# Your config repo, fetched with your own SSH key: a deploy key fits one repo only.
config_old=$(git -C config rev-parse HEAD 2>/dev/null)
config_new=$config_old
if [ -n "$config_old" ] && env -u GIT_SSH_COMMAND git -C config fetch --quiet; then
  config_new=$(git -C config rev-parse '@{upstream}' 2>/dev/null || echo "$config_old")
fi
[ "$new" = "$old" ] && [ "$config_new" = "$config_old" ] && exit 0
# A commit that failed waits for the next one (a fix, or a revert of the PR).
[ "$new $config_new" = "$(cat .failed-commit 2>/dev/null)" ] && exit 0
# A run you started by hand goes first; the next check picks this up.
pgrep -f '^[^ ]*python[^ ]* [^ ]*/ansible-playbook( |$)' >/dev/null && exit 0

# One line per commit: a link to it on GitHub, then its title.
changes=$(git log --format='%H %h %s' HEAD..FETCH_HEAD | while read -r full short title; do
  echo "• <a href=\"$web/commit/$full\">$short</a> $(html "$title")"
done
git -C config log --format='%h %s' "$config_old..$config_new" 2>/dev/null | while read -r short title; do
  echo "• config $short $(html "$title")"
done)
log=$(mktemp)
trap 'rm -f "$log"' EXIT
notify "🔄 Homelab update started
${changes}"

# Only new images can change the app data, so only then back up. The apps are stopped
# meanwhile, so their databases are consistent.
backup=false
if ! git diff --quiet HEAD FETCH_HEAD -- 'roles/*_stack/defaults/main.yml'; then
  backup=true
  restic cat config >/dev/null 2>&1 || restic init
  compose stop
  restic backup --tag pre-deploy --exclude "*/prometheus/data" "${backup_dirs[@]}"
  status=$?
  compose start
  if [ "$status" -ne 0 ]; then
    echo "$new $config_new" >.failed-commit
    printf '%s\n%s\n%s\n' "$(date '+%F %R')" "$new" "The backup failed" >.last-failure
    notify "❌ Homelab update skipped: the backup failed. journalctl -u homelab-autodeploy"
    exit 1
  fi
  restic forget --prune --tag pre-deploy --keep-last 5
fi

git reset --quiet --hard "$new"
# Fast-forward only: config/ is your own folder, so changes you haven't committed stay.
if [ "$config_new" != "$config_old" ] && ! git -C config merge --quiet --ff-only "$config_new"; then
  echo "$new $config_new" >.failed-commit
  notify "❌ Homelab update stopped: your config repo has changes that aren't committed. Commit or undo them in ~/homelab-config."
  exit 1
fi
if deploy; then
  rm -f .failed-commit
  notify "✅ Homelab updated to $(version HEAD)
${changes}"
  exit 0
fi

# The task that failed, from the line above Ansible's "fatal:" or "failed:".
task=$(awk '/^TASK \[/ { t = $0; sub(/^TASK /, "", t); sub(/ \*+$/, "", t) }
            /^(fatal|failed):/ { print t; exit }' "$log")
# Its error message (msg: and its indented continuation lines), else the end of the log.
error=$(awk '/^(fatal|failed):/ { f = 1; next }
             f && !d && /^ +msg:/ { match($0, /^ +/); d = RLENGTH; m = $0; sub(/^ +msg: */, "", m); next }
             d && match($0, /^ +/) && RLENGTH > d { sub(/^ +/, " "); m = m $0; next }
             d { exit }
             END { gsub(/^\047|\047$/, "", m); print m }' "$log")
[ -n "$error" ] || error=$(tail -n 3 "$log")
[ "$error" = "${error:0:300}" ] || error="${error:0:300}…"
echo "$new $config_new" >.failed-commit
# For the Telegram bot's /log: when, which commit, the task, its error.
printf '%s\n%s\n%s\n%s\n' "$(date '+%F %R')" "$new" "${task:-?}" "$error" >.last-failure

# Roll back: the app data from the backup, then the previous commit.
if $backup; then
  compose stop
  restore=$(sudo mktemp -d)
  restic restore latest --tag pre-deploy --target "$restore" &&
    for dir in "${backup_dirs[@]}"; do
      sudo rsync -a --delete --exclude prometheus/data "$restore$dir/" "$dir/"
    done
  sudo rm -rf "$restore"
fi
if [ "$new" = "$old" ]; then
  notify "❌ Homelab update failed: $(html "${task:-see the log}")
$(html "$error")
${changes}
Your config change didn't work: fix it in your config repo. journalctl -u homelab-autodeploy"
  exit 1
fi
git reset --quiet --hard "$old"
if deploy; then result="rolled back to the version before"; else result="the rollback failed too"; fi

notify "❌ Homelab update failed: $(html "${task:-see the log}")
$(html "$error")
${changes}
${result}. Merge a fix or revert the PR. journalctl -u homelab-autodeploy"
exit 1
